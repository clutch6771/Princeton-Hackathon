{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One immutable, versioned notification policy.",
  "properties": {
    "batch_size": {
      "maximum": 100,
      "minimum": 1,
      "title": "Batch Size",
      "type": "integer"
    },
    "cooldown_seconds": {
      "maximum": 86400,
      "minimum": 0,
      "title": "Cooldown Seconds",
      "type": "integer"
    },
    "minimum_conflicts": {
      "minimum": 1,
      "title": "Minimum Conflicts",
      "type": "integer"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated At"
    },
    "version": {
      "description": "0 means the configured default.",
      "minimum": 0,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "batch_size",
    "minimum_conflicts",
    "cooldown_seconds",
    "version"
  ],
  "title": "NotificationPolicy",
  "type": "object",
  "x-contract-version": "1"
}
