      "title": "Contract Version",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    }
  },
  "required": [
    "session_id"
  ],
  "title": "SessionEndRequest",
  "type": "object",
  "x-contract-version": "1"
}
