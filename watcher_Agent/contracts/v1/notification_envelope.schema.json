{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The ``notify`` object returned at the root of ingest responses.",
  "properties": {
    "body": {
      "title": "Body",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "notification_id": {
      "description": "Stable across redelivery.",
      "format": "uuid",
      "title": "Notification Id",
      "type": "string"
    },
    "reel_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Reel Ids",
      "type": "array"
    },
    "title": {
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "title",
    "body",
    "reel_ids",
    "notification_id",
    "expires_at"
  ],
  "title": "NotificationEnvelope",
  "type": "object",
  "x-contract-version": "1"
}
