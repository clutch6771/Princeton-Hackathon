# Judge backend configuration. Copy to .env (git-ignored) and fill in.
# NEVER commit real values. Full registry: docs/MEMORY_PARAMETERS.txt

# --- Modes (defaults are the safe production values) ----------------------
APP_ENV=production            # production | development
PRIVACY_MODE=enforce          # enforce | dev_permissive (development only)
PROVIDER_MODE=grok            # grok | gemini | local | fake (fake: development only)
STORAGE_MODE=postgres         # postgres | memory (memory: development only)

# --- Identity (demo header; not production authentication) ----------------
DEMO_USER_ID=
DEMO_USER_HEADER=X-Demo-User-Id

# --- Secrets ---------------------------------------------------------------
# Runtime role: DML on judge.*, SELECT only on the memory Store. TLS required.
DATABASE_URL=
# Owner role, used only by migrations/migrate.py and scripts/seed_dev_values.py
MIGRATION_DATABASE_URL=
XAI_API_KEY=
GROK_MODEL_ID=grok-4.7
GROK_TRANSCRIPTION_MODEL=grok-voice-transcribe-2.0
# Optional Gemini mode only:
GEMINI_API_KEY=

# --- Models (pinned by exact id; confirm against your Google project) ------
UNDERSTANDING_MODEL_ID=gemini-3.5-flash-lite
EMBEDDING_MODEL_ID=gemini-embedding-001
EMBEDDING_DIMENSION=768
EMBEDDING_TASK_TYPE=SEMANTIC_SIMILARITY
EMBEDDING_INDEXING_ENABLED=false  # Grok mode; no separate Gemini key required

# --- Session lifecycle -----------------------------------------------------
SESSION_IDLE_TIMEOUT_SECONDS=600

# --- Provider limits (check your actual quota; there is no paid fallback) --
PROVIDER_REQUESTS_PER_MINUTE=10
# PROVIDER_REQUESTS_PER_DAY=

# --- Approved values --------------------------------------------------------
VALUES_STORE_SCHEMA=public
VALUES_STORE_LAYOUT=guardian  # guardian entries (default) | document (legacy)
VALUES_REQUIRE_APPROVAL_METADATA=true

# --- SDK tracing must stay off (it would export frames, audio and values) ---
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# --- Tests only -------------------------------------------------------------
# TEST_DATABASE_URL=postgresql://user@127.0.0.1:5432/judge_test

# Grok audio uses STT + one vision judgment; allow both calls to complete.
PROVIDER_TIMEOUT_SECONDS=30
JOB_DEADLINE_SECONDS=90
PROVIDER_MAX_ATTEMPTS=1
UNDERSTANDING_MAX_OUTPUT_TOKENS=2048
