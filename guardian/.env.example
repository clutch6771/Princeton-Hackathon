# Copy these into the .env file in the repository root. Never commit real values.
GOOGLE_API_KEY=
# Optional spare Gemini keys, comma-separated. When the current key runs out of quota
# the Guardian and Reflector switch to the next one and stay on it until a restart.
# GOOGLE_API_KEY_FALLBACKS=
# Optional overrides (defaults are in guardian/config.py):
# GUARDIAN_CHAT_MODEL=google_genai:gemini-3.5-flash-lite
# GUARDIAN_REFLECTOR_MODEL=google_genai:gemini-3.5-flash-lite
# GUARDIAN_REQUESTS_PER_MINUTE=12             # chat model calls per minute
# GUARDIAN_REFLECTOR_REQUESTS_PER_MINUTE=6    # Reflector, on its own limiter; default half the chat rate

# Storage. Leave unset to keep everything in memory.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# GUARDIAN_DATABASE_URL=            # only if Guardian needs a different role from the Judge
# MIGRATION_DATABASE_URL=           # owner role, for `python -m guardian.storage setup`
# TEST_DATABASE_URL=                # a DISPOSABLE database; tests delete rows from it
